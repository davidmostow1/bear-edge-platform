# Copy this file to .env.local and fill in real keys.
# Never paste real keys into chat or commit .env.local.

# Enables sportsbook odds ingestion through The Odds API.
THE_ODDS_API_KEY=

# Optional alias if you prefer this name.
ODDS_API_KEY=

# Optional all-in-one odds/injuries/lineups alternative provider.
OPTICODDS_API_KEY=

# Optional all-in-one odds/results/settlement alternative provider.
SPORTS_GAME_ODDS_API_KEY=

# Optional multi-sport stats, lineups, injuries, news, odds, and historical data provider.
SPORTSDATAIO_API_KEY=

# Optional enterprise sports data provider for official stats, lineups, injuries, play-by-play, and tennis feeds.
SPORTRADAR_API_KEY=

# Reserved for a verified tennis stats provider.
TENNIS_API_KEY=

# Alternate tennis provider key name.
SPORTDEVS_API_KEY=

# Optional commercial weather provider. Open-Meteo currently needs no key for non-commercial use.
OPENWEATHER_API_KEY=

# Optional remote audit projection. The append-only local ledger remains authoritative.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OWNER_USER_ID=
# Set to 2.1.0 only after migration 20260718010000 is verified on the live project.
# Sync remains disabled when this capability receipt is blank or incompatible.
SUPABASE_AUDIT_SCHEMA_VERSION=

# Optional presentation and shadow-assignment controls only. These never authorize a BET.
STATSIG_SERVER_SDK_SECRET=
STATSIG_ENVIRONMENT=development
BEAR_EDGE_OPERATOR_ID=local_operator

# Optional fixed operator token. Local and LAN launch generate a one-time token when this is blank.
BEAR_EDGE_OPERATOR_TOKEN=

# Optional research/AI integrations. Deterministic engine logic does not require these.
EXA_API_KEY=
OPENAI_API_KEY=
