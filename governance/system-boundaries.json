      "ledgerRoots": [],
      "evidenceRoots": [],
      "bankrollStorageKeys": [],
      "mayWriteBearEdge": false,
      "mayAuthorizeWagers": false,
      "allowedImportMode": "content_addressed_evidence_only"
    },
    {
      "laneId": "sweet_bear_kalshi",
      "ownership": "external_research_source",
      "modelRegistry": null,
      "ledgerRoots": [],
      "evidenceRoots": [],
      "bankrollStorageKeys": [],
      "mayWriteBearEdge": false,
      "mayAuthorizeWagers": false,
      "allowedImportMode": "content_addressed_research_only"
    }
